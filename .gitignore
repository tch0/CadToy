# vscode local configs
/.vscode/**

# trae generated files
/.trae/

# build folder
/build/

# 3rd party generated and installed files
/3rdparty-install/
/3rdparty/build/

# imgui files, installed from 3rdparty/imgui, do not track them!
/imgui/**
!/imgui/CMakeLists.txt

# ImFileDialog files, installed from 3rdparty/ImFileDialog, only track CMakeLists.txt
/ImFileDialog/**
!/ImFileDialog/CMakeLists.txt

# for clangd, compile_commands.json is generated in build_tmp/, see .clangd for details
/build_tmp/
!/.vscode/settings.json